# AnyCast server configuration. Copy to .env and fill in.
# Your provider login lives ONLY here, on your own machine/server. Never paste it into chat.
XTREAM_URL=http://provider.example:8080
XTREAM_USERNAME=
XTREAM_PASSWORD=

# Secret used to encrypt provider credentials at rest and sign sessions (32+ random chars)
ANYCAST_SECRET=change-me-to-a-long-random-string
# First admin account, created on first start if no users exist
ANYCAST_ADMIN_USER=admin
ANYCAST_ADMIN_PASSWORD=change-me
PORT=8787
DATA_DIR=./data
BUFFER_DIR=./buffer
