# AnyCast server configuration. Copy to .env and fill in.

# Your provider login (optional). Easiest: leave these empty and enter it in the app after signing in
# as the admin (first-run screen, later Settings > Provider). If you set them here instead, they are
# used on the first start; a login entered in the app afterwards is kept until you change these lines.
# Your login stays on your own server either way. Never paste it into chat.
XTREAM_URL=
XTREAM_USERNAME=
XTREAM_PASSWORD=

# Secret used to encrypt provider credentials at rest and sign sessions (32+ random chars)
ANYCAST_SECRET=change-me-to-a-long-random-string
# First admin account, created on first start if no users exist
ANYCAST_ADMIN_USER=admin
ANYCAST_ADMIN_PASSWORD=change-me
PORT=8787
# Hardware video encoding for streams a device can't play: auto (test what works, else CPU) | off | vaapi | qsv | nvenc
# ANYCAST_HWACCEL=auto
# ANYCAST_VAAPI_DEVICE=/dev/dri/renderD128
DATA_DIR=./data
BUFFER_DIR=./buffer
# Automatic daily backups of accounts, profiles and their data, in DATA_DIR/backups: how many to keep (0 = off)
ANYCAST_BACKUP_KEEP=7
# CasaOS dashboard: where its Open button for AnyCast goes. Empty = http://<CasaOS address>:8787.
# For your HTTPS address, e.g. ANYCAST_CASAOS_HOST=anycast.example.com, _SCHEME=https, _PORT=443
# ANYCAST_CASAOS_HOST=
# ANYCAST_CASAOS_SCHEME=http
# ANYCAST_CASAOS_PORT=8787
